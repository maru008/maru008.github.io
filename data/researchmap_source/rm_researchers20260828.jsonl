{"insert":{"type":"published_papers","id":"45888697","user_id":"R000064079"},"merge":{"display":"disclosed","major_achievement":false,"paper_title":{"en":"AsyncMLD: Asynchronous Multi-LLM Framework for Dialogue Recommendation System"},"authors":{"en":[{"name":"Naoki Yoshimaru"},{"name":"Motoharu Okuma"},{"name":"Takamasa Iio"},{"name":"Kenji Hatano"}]},"published_paper_owner_roles":["lead"],"description":{"en":"We have reached a practical and realistic phase in human-support dialogue\nagents by developing a large language model (LLM). However, when requiring\nexpert knowledge or anticipating the utterance content using the massive size\nof the dialogue database, we still need help with the utterance content's\neffectiveness and the efficiency of its output speed, even if using LLM.\nTherefore, we propose a framework that uses LLM asynchronously in the part of\nthe system that returns an appropriate response and in the part that\nunderstands the user's intention and searches the database. In particular,\nnoting that it takes time for the robot to speak, threading related to database\nsearches is performed while the robot is speaking."},"publication_date":"2023-12-21","languages":["eng"],"referee":false,"invited":false,"published_paper_type":"symposium","identifiers":{"arxiv_id":["arXiv:2312.13925"]},"see_also":[{"label":"arxiv","@id":"http://arxiv.org/abs/arXiv:2312.13925","is_downloadable":false},{"@id":"http://arxiv.org/abs/2312.13925v1","label":"url","is_downloadable":false},{"@id":"http://arxiv.org/pdf/2312.13925v1","label":"url","is_downloadable":true}]}}
{"insert":{"type":"published_papers","id":"45888696","user_id":"R000064079"},"merge":{"display":"disclosed","major_achievement":false,"paper_title":{"en":"A Summarized History-based Dialogue System for Amnesia-Free Prompt Updates"},"authors":{"en":[{"name":"Hyejin Hong"},{"name":"Hibiki Kawano"},{"name":"Takuto Maekawa"},{"name":"Naoki Yoshimaru"},{"name":"Takamasa Iio"},{"name":"Kenji Hatano"}]},"description":{"en":"In today's society, information overload presents challenges in providing\noptimal recommendations. Consequently, the importance of dialogue systems that\ncan discern and provide the necessary information through dialogue is\nincreasingly recognized. However, some concerns existing dialogue systems rely\non pre-trained models and need help to cope with real-time or insufficient\ninformation. To address these concerns, models that allow the addition of\nmissing information to dialogue robots are being proposed. Yet, maintaining the\nintegrity of previous conversation history while integrating new data remains a\nformidable challenge. This paper presents a novel system for dialogue robots\ndesigned to remember user-specific characteristics by retaining past\nconversation history even as new information is added."},"publication_date":"2023-12-21","identifiers":{"arxiv_id":["arXiv:2312.13891"]},"see_also":[{"label":"arxiv","@id":"http://arxiv.org/abs/arXiv:2312.13891","is_downloadable":false},{"label":"url","@id":"http://arxiv.org/abs/2312.13891v1","is_downloadable":false},{"label":"url","@id":"http://arxiv.org/pdf/2312.13891v1","is_downloadable":true}]}}
